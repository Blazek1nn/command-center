# Diretório raiz onde ficam os projetos sob gestão
PROJECTS_ROOT=/home/user/projects

# SQLite assíncrono (aiosqlite)
DB_URL=sqlite+aiosqlite:///./command_center.db

# Limite hard de funcionários simultâneos
MAX_PARALLEL_WORKERS=3

# Caminho do CLI claude (autenticado via OAuth — créditos da conta Pro/Max).
# NÃO usamos ANTHROPIC_API_KEY: tudo passa pelo subprocess do `claude --print`.
CLAUDE_CLI_PATH=claude

LOG_LEVEL=INFO

# Modelos default (alias: opus | sonnet | haiku — resolvidos no claude_runner.py)
# Sonnet como default — Opus 2x mais caro sem ganho consistente em planejamento.
DEFAULT_MANAGER_MODEL=sonnet
DEFAULT_WORKER_MODEL=sonnet
# Modelo usado pelo small-talk fast-path
SMALLTALK_MODEL=haiku

# Timeout por execução de funcionário, em segundos
TASK_TIMEOUT_SECONDS=600
# Timeout pro Manager planejar — sem isso, SSE pode pendurar pra sempre
MANAGER_TIMEOUT_SECONDS=90

# MCP headless safety: bloqueia mcp.json sem allow-list `headless_mcps[]`
# Ative pra rigor extra; default false não quebra projetos sem mcp.json.
HEADLESS_STRICT=false

HOST=0.0.0.0
PORT=8000

# Analytics — PostHog (optional).
# Leave blank for log-only mode. Free up to 1M events/month at posthog.com.
# Install SDK first: uv pip install posthog
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
